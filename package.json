{
  "name": "pandafit",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:sim": "BIKE_SIM=1 electron-vite dev",
    "build": "electron-vite build",
    "probe": "tsx scripts/ble-probe.ts",
    "test": "vitest run --exclude 'tests/chaos/**'",
    "test:chaos": "vitest run tests/chaos",
    "test:garmin": "python3 -m unittest discover -s scripts/garmin",
    "typecheck": "tsc --noEmit",
    "coach:check": "tsx scripts/coach-check.ts",
    "ui:shots": "tsx scripts/ui-shots/run.ts",
    "live:adjust": "tsx scripts/live-adjust.ts",
    "live:mark": "tsx scripts/live-mark.ts",
    "live:undo": "tsx scripts/live-undo.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "ui:web-shots": "npm run build:web && tsx scripts/web-shots.ts",
    "test:web-smoke": "npm run build:web && tsx scripts/web-smoke.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "media:fedb": "tsx scripts/fedb-media.ts",
    "app": "(test -d src/web/public/exercises/fedb || npm run media:fedb || true) && electron-vite build && electron-builder --mac dir && bash scripts/install-app.sh"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.218.0",
    "@stoprocent/noble": "^2.8.0",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^6.0.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@stoprocent/noble@2.8.0": true,
    "@stoprocent/bluetooth-hci-socket@2.3.0": true,
    "usb@2.19.1": true,
    "esbuild@0.28.2": true,
    "@serialport/bindings-cpp@12.0.1": true
  },
  "productName": "Pandafit",
  "build": {
    "appId": "de.bike-coach.app",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "resources/icon.png",
      "scripts/garmin/*.py",
      "package.json"
    ],
    "asarUnpack": [
      "scripts/garmin/*.py"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "resources/icon.icns",
      "identity": null,
      "category": "public.app-category.healthcare-fitness",
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Pandafit verbindet sich per Bluetooth mit Trainer, Pulsgurt und Clicker.",
        "NSBluetoothPeripheralUsageDescription": "Pandafit verbindet sich per Bluetooth mit Trainer, Pulsgurt und Clicker."
      }
    },
    "npmRebuild": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Basti93/pandafit.git"
  }
}
