{
  "compilerOptions": {
    "resolveJsonModule": true,
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "jsx": "react-jsx", "noEmit": true, "types": ["node", "vitest/globals"]
  },
  "include": ["src", "tests", "scripts", "web-server", "src/web", "vite.web.config.ts"]
}
